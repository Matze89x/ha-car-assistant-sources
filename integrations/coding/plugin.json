  "docs": "Keeps the coding of the car's control units: for each unit the factory value (fixed once written) next to the current one, changed bytes marked, bits viewable, notes. Entries are written by hand or delivered by a plugin that reads the car. Every control unit is a collapsible row (address badge, name, changed bytes); the byte grid, the new value and the notes are edited right there, 'New = factory' puts the factory value into the current coding (saved with Save).",
  "interfaces": [
    {
      "direction": "offers",
      "name": "Control units (read)",
      "path": "/api/v1/vehicles/<id>/modules/coding/units",
      "note": "GET: the entries in their order, as plain values"
    },
    {
      "direction": "offers",
      "name": "Control units (write)",
      "path": "/api/v1/vehicles/<id>/modules/coding/units",
      "note": "POST: a plugin may add, change and delete entries; fields marked once keep their first value"
    }
  ]
}
