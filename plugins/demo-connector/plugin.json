  "l10n": {
    "de": {
      "name": "Demo-Anbindung",
      "description": "Spielt für ein Demo-Auto eine ausgedachte Fahrt ab, alle 5 Sekunden, über die normale Schnittstelle."
    }
  },
  "docs": "A demo plugin: it plays a made-up drive (parked, enter, start, drive, stop, leave) for a demo car and delivers the values through the normal Connector API, exactly like a real connection would. It needs no device and no settings. Start and stop it with the buttons on its tile. Look at the page Interfaces after a few minutes to see what it really sent.",
  "interfaces": [
    {
      "direction": "sends",
      "name": "Vehicle data",
      "path": "/api/v1/vehicles/<id>/data",
      "fields": [
        "odometer_km",
        "position",
        "speed_kmh",
        "ignition",
        "doors",
        "windows",
        "locked",
        "fuel_level_pct",
        "range_km",
        "battery_12v_v",
        "tyre_pressure_bar",
        "warnings"
      ],
      "note": "every 5 seconds while it runs"
    },
    {
      "direction": "reads",
      "name": "Control",
      "path": "/api/v1/vehicles/<id>/control",
      "note": "the debug switch and the reporting interval come back in every answer"
    }
  ]
}
